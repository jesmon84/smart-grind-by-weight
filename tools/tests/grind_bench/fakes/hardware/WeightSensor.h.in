#pragma once

#include <Arduino.h>
#include <atomic>
#include <cstdint>

#include "../config/constants.h"
#include "circular_buffer_math/circular_buffer_math.h"

// Bench scale. A simulated ADC stands in for the HX711 driver; everything
// that turns its samples into weights is the firmware's own code, which
// grind_bench_test.py copies in from src/hardware/WeightSensor.h and .cpp.
class WeightSensor {
public:
    enum class HardwareFault { NONE = 0, NOT_CONNECTED, NO_DATA, INVALID_SAMPLE_RATE };

    // State the firmware's methods work on.
    CircularBufferMath raw_filter;
    float cal_factor = USER_DEFAULT_CALIBRATION_FACTOR;
    int32_t tare_offset = 0;
    std::atomic<bool> tare_initialized_{false};
    std::atomic<bool> has_sample_{false};
    std::atomic<uint32_t> last_sample_ms_{0};
    std::atomic<int32_t> diagnostic_raw_adc_{-1};
    std::atomic<HardwareFault> hardware_fault_{HardwareFault::NONE};
    static const uint8_t DATA_SET = 16 + 1 + 1;
    bool doTare = false;
    uint8_t tareTimes = 0;
    bool tareStatus = false;
    float current_weight = 0.0f;
    int32_t current_raw_adc = 0;
    bool data_available = false;

    // Simulated ADC: the bench sets a conversion, the firmware collects it.
    bool adc_driver = true;
    bool conversion_ready = false;
    int32_t conversion_raw = 0;
    bool data_waiting_async() const { return conversion_ready; }
    bool update_async() {
        conversion_ready = false;
        return true;
    }
    int32_t get_raw_adc_data() const { return conversion_raw; }
    void update_temperature_if_available() {}

    HardwareFault get_hardware_fault() const { return hardware_fault_.load(); }
    bool has_hardware_fault() const { return get_hardware_fault() != HardwareFault::NONE; }

    // ---- Firmware code from src/hardware/WeightSensor.h ----
@PRODUCTION_INLINE@

    // ---- Firmware code from src/hardware/WeightSensor.cpp ----
    void tareNoDelay();
    bool is_settled(uint32_t window_ms = GRIND_SCALE_PRECISION_SETTLING_TIME_MS);
    bool check_settling_complete(uint32_t window_ms, float* settled_weight_out = nullptr);
    float get_weight_low_latency() const;
    float get_display_weight();
    float get_weight_high_latency() const;
    float get_weight_smoothed(uint32_t window_ms) const;
    float get_untared_level(uint32_t window_ms) const;
    bool get_shaken_weight(uint32_t window_ms, float* weight_out) const;
    float get_standard_deviation_g(uint32_t window_ms = 500) const;
    float get_instant_weight() const;
    int32_t get_raw_adc_smoothed(uint32_t window_ms) const;
    void set_zero_offset(int32_t offset);
    float get_flow_rate(uint32_t window_ms = 200) const;
    float get_flow_rate_95th_percentile(uint32_t window_ms = 200) const;
    float get_calibration_factor();
    bool sample_and_feed_filter();
};
